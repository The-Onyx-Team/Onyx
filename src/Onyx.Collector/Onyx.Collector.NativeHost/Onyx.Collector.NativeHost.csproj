<Project Sdk="Microsoft.NET.Sdk">

    <!-- Native messaging host for the Onyx browser extension on Windows (onyx-native-host.exe, shipped next to the
         app). Browsers start it; it relays the extension's reports to the running app. Published with Native AOT
         so it is small and starts quickly. On Linux, onyx-agent plays this role ('onyx-agent native-host'). -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>onyx-native-host</AssemblyName>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Onyx.Collector.Core\Onyx.Collector.Core.csproj" />
    </ItemGroup>

</Project>
