<Project Sdk="Microsoft.NET.Sdk">

    <!-- Headless usage collector for Linux desktops (onyx-agent). Runs as a systemd user service and uploads
         to the Onyx server; the web dashboard is the UI. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>onyx-agent</AssemblyName>
        <RootNamespace>Onyx.Collector.Linux</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
        <!-- D-Bus for GNOME (Shell extension) and KDE (KWin script) on Wayland. -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    </ItemGroup>

    <!-- Installed by the agent itself: onyx-agent gnome install / the KWin script is loaded at start. -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\..\packaging\linux\gnome-extension\metadata.json" LogicalName="gnome-extension/metadata.json" />
        <EmbeddedResource Include="..\..\..\packaging\linux\gnome-extension\extension.js" LogicalName="gnome-extension/extension.js" />
        <EmbeddedResource Include="..\..\..\packaging\linux\kwin\onyx-focus.js" LogicalName="kwin/onyx-focus.js" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Onyx.Collector.Core\Onyx.Collector.Core.csproj" />
    </ItemGroup>

</Project>
