@page "/account/manage/changepassword"
@inject IUserManager UserManager
@inject ISnackbar Snackbar

<PageTitle>Password · Onyx</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Change password</MudText>
<MudText Typo="Typo.body2" Class="text-muted mb-4">
    Your password signs you in. It is not your encryption passphrase, which you change in
    <MudLink Href="/settings#encryption" Typo="Typo.body2">Settings</MudLink>.
</MudText>

<MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="max-width: 520px">
    <EditForm Model="m_Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator/>
        <MudTextField T="string" Label="Current password" @bind-Value="m_Model.Current" For="@(() => m_Model.Current)"
                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3"/>
        <MudTextField T="string" Label="New password" @bind-Value="m_Model.New" For="@(() => m_Model.New)"
                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" HelperText="At least 8 characters"/>
        <MudTextField T="string" Label="Repeat new password" @bind-Value="m_Model.Repeat" For="@(() => m_Model.Repeat)"
                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3"/>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="m_Busy">
            @(m_Busy ? "Saving…" : "Change password")
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private Model m_Model = new();
    private bool m_Busy;

    private async Task SaveAsync()
    {
        m_Busy = true;
        var error = await UserManager.ChangePasswordAsync(m_Model.Current, m_Model.New);
        m_Busy = false;
        if (error is null)
        {
            Snackbar.Add("Password changed.", Severity.Success);
            m_Model = new Model();
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private sealed class Model
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string Current { get; set; } = "";

        [Required, MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string New { get; set; } = "";

        [Compare(nameof(New), ErrorMessage = "The passwords don't match.")]
        public string Repeat { get; set; } = "";
    }
}
