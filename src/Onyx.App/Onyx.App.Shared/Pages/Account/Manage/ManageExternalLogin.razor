@page "/account/manage/external"
@using Onyx.Collector.Core
@using Onyx.Data.ApiSchema
@inject OnyxApiClient Api
@inject IUserManager UserManager
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IPlatformService PlatformService

<PageTitle>External logins · Onyx</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">External logins</MudText>
<MudText Typo="Typo.body2" Class="text-muted mb-4">Sign in with Google, Microsoft or GitHub instead of your password.</MudText>

@if (m_Logins is null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Linked</MudText>
        @if (m_Logins.Count == 0)
        {
            <MudText Typo="Typo.body2">None.</MudText>
        }
        @foreach (var login in m_Logins)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudText>@login.DisplayName</MudText>
                <MudSpacer/>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => RemoveAsync(login)">Remove</MudButton>
            </div>
        }
    </MudPaper>

    @if (m_Other.Count > 0)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Add</MudText>
            @if (m_Ticket is null)
            {
                <MudButton Variant="Variant.Outlined" OnClick="PrepareAsync">Link another login…</MudButton>
            }
            else
            {
                <form action="/account/link-external-login" method="post" class="d-flex flex-wrap gap-2">
                    <input type="hidden" name="ticket" value="@m_Ticket"/>
                    @foreach (var scheme in m_Other)
                    {
                        <button type="submit" name="provider" value="@scheme.Name" class="external-login-button">@scheme.DisplayName</button>
                    }
                </form>
            }
        </MudPaper>
    }
}

@code {
    private List<ExternalLoginDto>? m_Logins;
    private List<ExternalSchemeDto> m_Other = [];
    private string? m_Ticket;

    protected override async Task OnInitializedAsync()
    {
        var fragment = new Uri(NavigationManager.Uri).Fragment;
        if (fragment.StartsWith("#status=linked"))
            Snackbar.Add("The login was linked.", Severity.Success);
        else if (fragment.StartsWith("#error="))
            Snackbar.Add(Uri.UnescapeDataString(fragment["#error=".Length..]), Severity.Error);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            m_Logins = await Api.SendAuthorizedAsync<List<ExternalLoginDto>>(HttpMethod.Get, "/api/user/logins");
            m_Other = (await UserManager.GetExternalSchemesAsync())
                .Where(s => m_Logins.All(l => l.Provider != s.Name)).ToList();
        }
        catch (Exception e)
        {
            m_Logins = [];
            Snackbar.Add(OnyxApiClient.ErrorMessage(e), Severity.Error);
        }
    }

    /// <summary>A short-lived ticket lets the form post (which carries no token) link to this account.</summary>
    private async Task PrepareAsync() =>
        m_Ticket = (await Api.SendAuthorizedAsync<LinkTicketDto>(HttpMethod.Post, "/api/user/logins/link-ticket")).Ticket;

    private async Task RemoveAsync(ExternalLoginDto login)
    {
        try
        {
            await Api.SendAuthorizedAsync<object?>(HttpMethod.Delete, $"/api/user/logins/{Uri.EscapeDataString(login.Provider)}");
            await LoadAsync();
        }
        catch (Exception e)
        {
            Snackbar.Add(OnyxApiClient.ErrorMessage(e), Severity.Error);
        }
    }
}
