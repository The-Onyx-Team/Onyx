@page "/Account/Manage/Profile"
@using Onyx.Collector.Core.Crypto
@using Onyx.App.Shared.Services.Client
@using Onyx.Data.ApiSchema
@inject IProfileService ProfileService
@inject PrivateProfileService PrivateProfile
@inject ISnackbar Snackbar

<PageTitle>Profile · Onyx</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-0">
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-1">Profile</MudText>
        <MudText Typo="Typo.body2" Class="text-muted mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Style="vertical-align: -4px"/>
            Your picture, real name and phone number are end-to-end encrypted: only you, and the friends you share
            with, can see them. Your user name and email address stay readable for the server, because they are how
            you sign in and how friends find you.
        </MudText>

        @if (m_Profile is null || m_Private is null)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-6" Wrap="Wrap.Wrap">
                <MudAvatar Size="Size.Large" Color="Color.Secondary" Style="width: 96px; height: 96px; font-size: 2.2rem">
                    @if (m_Private.AvatarDataUrl is { } avatar)
                    {
                        <MudImage Src="@avatar" Alt="Profile picture" ObjectFit="ObjectFit.Cover"/>
                    }
                    else
                    {
                        @Initial
                    }
                </MudAvatar>
                <MudStack Spacing="2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadAvatarAsync" Accept=".png,.jpg,.jpeg,.webp"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="m_Busy"
                                       StartIcon="@Icons.Material.Filled.Image">
                                Upload picture
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="DeleteAvatarAsync"
                               Disabled="@(m_Busy || m_Private.Avatar is null)"
                               StartIcon="@Icons.Material.Filled.Delete">
                        Remove picture
                    </MudButton>
                    <MudText Typo="Typo.caption">PNG, JPEG or WebP. It is scaled down to 256 × 256 pixels.</MudText>
                </MudStack>
            </MudStack>

            <EditForm Model="m_Model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator/>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="User name" @bind-Value="m_Model.UserName" For="@(() => m_Model.UserName)"
                                      Variant="Variant.Outlined" HelperText="Letters and digits; friends find you by it" Immediate="true"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Real name (optional)" @bind-Value="m_Model.DisplayName"
                                      For="@(() => m_Model.DisplayName)" Variant="Variant.Outlined" MaxLength="100"
                                      HelperText="Encrypted; shown to friends you share with" Immediate="true"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Phone number" @bind-Value="m_Model.PhoneNumber"
                                      For="@(() => m_Model.PhoneNumber)" Variant="Variant.Outlined" InputType="InputType.Telephone"
                                      HelperText="Encrypted; only you see it" Immediate="true"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" Value="@m_Profile.Email" ReadOnly="true" Variant="Variant.Outlined"
                                      HelperText="@(m_Profile.EmailConfirmed ? "Confirmed" : "Not confirmed yet")"/>
                    </MudItem>
                </MudGrid>

                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                           Disabled="@(m_Busy || !IsChanged)" StartIcon="@Icons.Material.Filled.Save">
                    @(m_Busy ? "Saving…" : "Save changes")
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    /// <summary>Upload size after scaling; the server accepts up to 512 KB.</summary>
    private const long MaxUploadBytes = 512 * 1024;

    private ProfileDto? m_Profile;
    private ProfilePayload? m_Private;
    private readonly ProfileModel m_Model = new();
    private bool m_Busy;

    private string Initial =>
        (m_Private?.DisplayName ?? m_Profile?.UserName) is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    private bool IsChanged => m_Profile is not null && m_Private is not null &&
                              (m_Model.UserName != m_Profile.UserName
                               || Clean(m_Model.PhoneNumber) != m_Private.PhoneNumber
                               || Clean(m_Model.DisplayName) != m_Private.DisplayName);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            // The encrypted profile first: it also moves a plain-text phone number or picture into it.
            m_Private = await PrivateProfile.GetAsync();
            m_Profile = await ProfileService.GetAsync();
            m_Model.UserName = m_Profile.UserName ?? "";
            m_Model.PhoneNumber = m_Private.PhoneNumber;
            m_Model.DisplayName = m_Private.DisplayName;
        }
        catch (Exception e)
        {
            Snackbar.Add($"Could not load the profile: {e.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            if (m_Model.UserName != m_Profile!.UserName
                && await ProfileService.UpdateAsync(m_Model.UserName, null) is { } error)
                return error;

            var updated = m_Private! with { PhoneNumber = Clean(m_Model.PhoneNumber), DisplayName = Clean(m_Model.DisplayName) };
            if (updated != m_Private)
                await PrivateProfile.SaveAsync(updated);
            return null;
        }, "Profile saved.");
    }

    private async Task UploadAvatarAsync(IBrowserFile? file)
    {
        if (file is null)
            return;

        await RunAsync(async () =>
        {
            // Scaled in the browser (or web view) before uploading, so large photos work too.
            IBrowserFile scaled;
            try
            {
                scaled = await file.RequestImageFileAsync("image/jpeg", 256, 256);
            }
            catch (Exception e)
            {
                return $"The picture could not be read: {e.Message}";
            }

            if (scaled.Size > MaxUploadBytes)
                return "The picture is too large, even after scaling it down.";

            using var stream = new MemoryStream();
            await scaled.OpenReadStream(MaxUploadBytes).CopyToAsync(stream);
            await PrivateProfile.SaveAsync(m_Private! with { Avatar = stream.ToArray(), AvatarContentType = "image/jpeg" });
            return null;
        }, "Picture updated.");
    }

    private async Task DeleteAvatarAsync() =>
        await RunAsync(async () =>
        {
            await PrivateProfile.SaveAsync(m_Private! with { Avatar = null, AvatarContentType = null });
            return null;
        }, "Picture removed.");

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>Runs a change, shows its result and reloads the profile.</summary>
    private async Task RunAsync(Func<Task<string?>> change, string success)
    {
        m_Busy = true;
        try
        {
            var error = await change();
            if (error is null)
            {
                Snackbar.Add(success, Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (Exception e)
        {
            Snackbar.Add($"Could not save: {e.Message}", Severity.Error);
        }
        finally
        {
            m_Busy = false;
        }
    }

    private sealed class ProfileModel
    {
        [Required(ErrorMessage = "Enter a user name.")]
        [RegularExpression("^[a-zA-Z0-9]+$", ErrorMessage = "Use letters and digits only.")]
        public string UserName { get; set; } = "";

        [RegularExpression(@"^\+?[0-9 ()/-]{3,30}$", ErrorMessage = "Enter a valid phone number.")]
        public string? PhoneNumber { get; set; }

        [MaxLength(100)]
        public string? DisplayName { get; set; }
    }
}
