@page "/account/external"
@using Onyx.Data.ApiSchema
@inject IUserManager UserManager
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@layout AuthNavLayout

@* Where the server sends the browser after Google, Microsoft or GitHub. The result is in the URL fragment, which
   never reaches a server: a one-time code to sign in with, or "register" for a new account, or an error. *@

<PageTitle>Sign in · Onyx</PageTitle>

@if (m_Error is not null)
{
    <MudText Typo="Typo.h5" Class="mb-2">Sign-in failed</MudText>
    <MudAlert Severity="Severity.Error" Class="mb-3">@m_Error</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/account/login">Back to sign in</MudButton>
}
else if (m_Pending is { } pending)
{
    <MudText Typo="Typo.h5" Class="mb-2">Create your account</MudText>
    <MudText Class="mb-3">
        You signed in with @pending.Provider@(pending.Email is null ? "" : $" as {pending.Email}"). There is no Onyx account
        for it yet.
    </MudText>
    <div class="consent-box mb-3">
        <MudCheckBox T="bool" @bind-Value="m_Consent" Color="Color.Primary" Dense="true">
            I have read the <MudLink Href="/privacy" Target="_blank">privacy policy</MudLink> and agree that Onyx records
            which apps (and, if I turn it on, which websites) I use and for how long, to show it to me.
        </MudCheckBox>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(!m_Consent || m_Busy)"
               OnClick="RegisterAsync">Create account</MudButton>
}
else
{
    <div class="d-flex align-center gap-3"><MudProgressCircular Indeterminate="true" Size="Size.Small"/> Signing in…</div>
}

@code {
    private string? m_Error;
    private ExternalPendingDto? m_Pending;
    private bool m_Consent;
    private bool m_Busy;
    private string m_ReturnUrl = ReturnUrl.Default;

    protected override async Task OnInitializedAsync()
    {
        var fragment = new Uri(NavigationManager.Uri).Fragment.TrimStart('#');
        var values = fragment.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "");
        m_ReturnUrl = ReturnUrl.Sanitize(values.GetValueOrDefault("returnUrl"));

        // Drop the code from the address bar and history.
        NavigationManager.NavigateTo("/account/external", replace: true);

        if (values.TryGetValue("error", out var error))
        {
            m_Error = error;
        }
        else if (values.TryGetValue("code", out var code))
        {
            var result = await UserManager.CompleteExternalLoginAsync(code);
            if (result.Success)
                NavigationManager.NavigateTo(m_ReturnUrl);
            else
                m_Error = result.Message;
        }
        else if (values.ContainsKey("register"))
        {
            m_Pending = await UserManager.GetPendingExternalLoginAsync();
            if (m_Pending is null)
                m_Error = "The sign-in has expired. Please try again.";
        }
        else
        {
            NavigationManager.NavigateTo("/account/login");
        }
    }

    private async Task RegisterAsync()
    {
        m_Busy = true;
        var result = await UserManager.RegisterExternalAsync(m_Consent);
        m_Busy = false;
        if (result.Success)
            NavigationManager.NavigateTo(m_ReturnUrl);
        else
            Snackbar.Add(result.Message ?? "The account could not be created.", Severity.Error);
    }
}
