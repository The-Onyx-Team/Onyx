@page "/devices"
@page "/data"
@using Onyx.App.Shared.Services.Usage
@using Onyx.Data.ApiSchema
@layout AppLayout
@inject IDeviceManager DeviceManager
@inject IStatsService StatsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject DeviceLinkService DeviceLink

<PageTitle>Devices</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    @if (m_Status.Supported)
    {
        <MudPaper Class="pa-4 mb-6" Elevation="2">
            <MudText Typo="Typo.h6">This device</MudText>

            @if (!m_Status.HasPermission)
            {
                <MudAlert Severity="Severity.Warning" Class="my-3">
                    Onyx needs usage access to see which apps you use. Android asks for it in the system settings.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenSettings">Grant usage access</MudButton>
            }
            else
            {
                <MudText Class="mt-2">
                    Last upload: @(m_Status.LastUpload is { } last ? last.ToLocalTime().ToString("g") : "not yet")
                </MudText>
                @if (m_Status.PendingBuckets > 0)
                {
                    <MudText Typo="Typo.body2">@m_Status.PendingBuckets hour(s) waiting to be uploaded</MudText>
                }
                @if (m_Status.LastError is { } error)
                {
                    <MudAlert Severity="Severity.Error" Class="my-2">@error</MudAlert>
                }
                <MudButton Class="mt-3" Variant="Variant.Outlined" Disabled="m_Syncing" OnClick="SyncNow">
                    @(m_Syncing ? "Uploading..." : "Upload now")
                </MudButton>
            }

            @if (m_Status.RecordWebsites is { } recordWebsites)
            {
                <MudDivider Class="my-4"/>
                <MudSwitch T="bool" Value="recordWebsites" ValueChanged="SetRecordWebsitesAsync" Color="Color.Primary"
                           Disabled="m_Switching" Label="Record websites in browsers"/>
                <MudText Typo="Typo.body2" Class="mt-1">
                    Splits browser time by website. Only the domain of the active tab is recorded (for example
                    "github.com"), never the full address, and never private windows. Needs the Onyx Websites browser
                    extension (<MudLink Href="/downloads" Typo="Typo.body2">Downloads</MudLink>).
                    Excluded websites and deleting the history: <MudLink Href="/settings#websites" Typo="Typo.body2">Settings</MudLink>.
                </MudText>
                @if (recordWebsites)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        @(m_Status.ActiveWebsite is { } site
                            ? $"Browser extension connected, last website: {site}"
                            : "No report from the browser extension yet. Install it, or switch to a browser tab.")
                    </MudText>
                }
            }
        </MudPaper>
    }

    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.h6">Your devices</MudText>
        <MudSpacer/>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Watch"
                   OnClick="() => m_Linking = !m_Linking">Link a watch</MudButton>
    </div>

    @if (m_Linking)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body2" Class="mb-2">
                Open Onyx on the watch; it shows a code. Enter it here: the watch signs in to your account and gets
                the encryption key, encrypted so that only the watch can read it.
            </MudText>
            <div class="d-flex align-center gap-2">
                <MudTextField T="string" @bind-Value="m_LinkCode" Label="Code from the watch" Placeholder="7K2QM-X9D4R"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" MaxLength="12"
                              Style="max-width: 220px; font-family: monospace; text-transform: uppercase"/>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="m_LinkBusy || string.IsNullOrWhiteSpace(m_LinkCode)"
                           OnClick="LinkAsync">Link</MudButton>
            </div>
        </MudPaper>
    }

    @if (m_Devices is null)
    {
        <MudProgressLinear Indeterminate="true"/>
    }
    else if (m_Devices.Count == 0)
    {
        <MudText>
            No devices yet. Install the Onyx app on your phone or computer and sign in; it registers itself.
            <MudLink Href="/downloads">Downloads</MudLink>
        </MudText>
    }
    else
    {
        <MudTable Items="m_Devices" Dense="true" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Platform</MudTh>
                <MudTh>Last upload</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Platform">@(context.Platform ?? "-")</MudTd>
                <MudTd DataLabel="Last upload">@(context.LastSeen is { } seen ? seen.ToLocalTime().ToString("g") : "never")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   title="Remove device and its data" OnClick="@(() => RemoveAsync(context))"/>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private CollectionStatus m_Status = new(false, false, null, null, 0);
    private List<DeviceDto>? m_Devices;
    private bool m_Syncing;
    private bool m_Switching;
    private bool m_Linking;
    private bool m_LinkBusy;
    private string? m_LinkCode;

    private async Task LinkAsync()
    {
        m_LinkBusy = true;
        try
        {
            if (await DeviceLink.LinkAsync(m_LinkCode ?? "") is { } error)
            {
                Snackbar.Add(error, Severity.Warning);
                return;
            }

            Snackbar.Add("Linked. The watch uploads its usage from now on and appears here after its first upload.", Severity.Success);
            m_Linking = false;
            m_LinkCode = null;
        }
        catch (Exception e)
        {
            Snackbar.Add($"Could not link: {e.Message}", Severity.Error);
        }
        finally
        {
            m_LinkBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        m_Status = StatsService.GetStatus();
        await LoadDevicesAsync();
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            m_Devices = await DeviceManager.GetDevices();
        }
        catch (Exception e)
        {
            m_Devices = [];
            Snackbar.Add($"Could not load devices: {e.Message}", Severity.Error);
        }
    }

    private void OpenSettings()
    {
        StatsService.OpenUsageAccessSettings();
    }

    private async Task SyncNow()
    {
        m_Syncing = true;
        try
        {
            m_Status = await StatsService.SyncNowAsync();
            await LoadDevicesAsync();
        }
        finally
        {
            m_Syncing = false;
        }
    }

    private async Task SetRecordWebsitesAsync(bool enabled)
    {
        if (enabled)
        {
            var confirmed = await DialogService.ShowMessageBox("Record websites",
                "Onyx will record which website (domain only) is open in your browser while it is in front, " +
                "and upload it to your account. Websites can reveal sensitive things about you, such as health, " +
                "religion or political views. You can exclude websites and delete the history in Settings, and " +
                "turn this off at any time.",
                yesText: "Turn on", cancelText: "Cancel");
            if (confirmed != true)
                return;
        }

        m_Switching = true;
        try
        {
            m_Status = await StatsService.SetRecordWebsitesAsync(enabled);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            m_Switching = false;
        }
    }

    private async Task RemoveAsync(DeviceDto device)
    {
        var confirmed = await DialogService.ShowMessageBox("Remove device",
            $"Remove \"{device.Name}\" and all usage data it uploaded? This cannot be undone. " +
            "If the app is still installed there, it will register the device again on its next upload.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await DeviceManager.UnregisterDeviceAsync(device.Id);
            m_Devices?.Remove(device);
        }
        catch (Exception e)
        {
            Snackbar.Add($"Could not remove the device: {e.Message}", Severity.Error);
        }
    }
}
