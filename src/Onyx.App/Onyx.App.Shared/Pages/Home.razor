@page "/home"
@using Onyx.App.Shared.Services.Dashboard
@using Onyx.App.Shared.Services.Usage
@using Onyx.Data.ApiSchema
@layout AppLayout
@inject IDeviceManager DeviceManager
@inject IUsageDataService UsageService
@inject IAppManager AppManager
@inject ClientTimeZone ClientTimeZone

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @* Controls of the same height on one line, wrapping on narrow screens. *@
    <div class="d-flex flex-wrap align-center gap-3 mb-4 dashboard-filters">
        <MudToggleGroup T="DashboardRange" Value="m_Range" ValueChanged="OnRangeChanged" Color="Color.Primary"
                        SelectedClass="mud-theme-primary" Outlined="true" Delimiters="true" Size="Size.Medium"
                        Class="dashboard-range">
            <MudToggleItem Value="DashboardRange.Day" Text="Day"/>
            <MudToggleItem Value="DashboardRange.Week" Text="Week"/>
            <MudToggleItem Value="DashboardRange.Month" Text="Month"/>
        </MudToggleGroup>
        <div class="dashboard-filter">
            <MudDatePicker Label="Date" Date="m_Anchor" DateChanged="OnDateChanged" Variant="Variant.Outlined"
                           Margin="Margin.Dense" DateFormat="dd.MM.yyyy" MaxDate="m_Today"/>
        </div>
        <div class="dashboard-filter">
            <MudSelect T="int" Label="Device" Value="@(m_DeviceId ?? 0)" ValueChanged="@(id => OnDeviceChanged(id == 0 ? null : id))"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int" Value="0">All devices</MudSelectItem>
                @foreach (var device in m_Devices)
                {
                    <MudSelectItem T="int" Value="device.Id">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    @if (m_Error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@m_Error</MudAlert>
    }

    @if (m_Summary is null)
    {
        <MudProgressLinear Indeterminate="true"/>
    }
    else if (m_Summary.Total == TimeSpan.Zero)
    {
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6">No usage recorded for @PeriodText</MudText>
            @if (m_Devices.Count == 0)
            {
                <MudText Class="mt-2">
                    Data appears here once a device uploads it. Install Onyx on your phone or computer and sign in.
                    <MudLink Href="/downloads">Downloads</MudLink>
                </MudText>
            }
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4" Elevation="1" Style="height: 100%">
                    <MudText Typo="Typo.caption">Screen time, @PeriodText</MudText>
                    <MudText Typo="Typo.h4">@UsageSummary.Format(m_Summary.Total)</MudText>
                    @if (m_Summary.Range != DashboardRange.Day)
                    {
                        <MudText Typo="Typo.body2">@UsageSummary.Format(m_Summary.Total / ElapsedDays) per day on average</MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4" Elevation="1" Style="height: 100%">
                    <MudText Typo="Typo.caption">Most used</MudText>
                    <MudText Typo="Typo.h5">@m_Summary.Apps[0].Name</MudText>
                    <MudText Typo="Typo.body2">@UsageSummary.Format(m_Summary.Apps[0].Time) (@m_Summary.Apps[0].Share.ToString("P0"))</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4" Elevation="1" Style="height: 100%">
                    <MudText Typo="Typo.caption">Apps used</MudText>
                    <MudText Typo="Typo.h4">@m_Summary.Apps.Count</MudText>
                    <MudText Typo="Typo.body2">on @m_Summary.Devices.Count device(s)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6">@(m_Summary.Range == DashboardRange.Day ? "By hour (minutes)" : "By day (hours)")</MudText>
                    <MudChart ChartType="ChartType.StackedBar"
                              ChartSeries="@m_ChartSeries"
                              XAxisLabels="@m_Summary.PeriodLabels"
                              LegendPosition="Position.Bottom"
                              Width="100%" Height="320px"
                              ChartOptions="@m_ChartOptions"
                              AxisChartOptions="@(new AxisChartOptions { StackedBarWidthRatio = 0.6 })"/>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6">Categories</MudText>
                    <MudChart ChartType="ChartType.Donut"
                              InputData="@m_Summary.Categories.Select(c => c.Time.TotalHours).ToArray()"
                              InputLabels="@m_Summary.Categories.Select(c => $"{c.Name} ({c.Share:P0})").ToArray()"
                              LegendPosition="Position.Bottom"
                              Width="100%" Height="260px"/>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Elevation="1">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.h6">Apps</MudText>
                        <MudLink Href="/settings#apps" Typo="Typo.body2">Rename apps</MudLink>
                    </div>
                    <MudTable Items="m_Summary.Apps" Dense="true" Hover="true" Elevation="0" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh>App</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh Style="text-align: right">Time</MudTh>
                            <MudTh Style="width: 30%">Share</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="App">
                                <div class="app-name-cell">
                                    <AppIcon Src="@m_Icons.GetValueOrDefault(context.AppId)" Name="@context.Name"/>
                                    <span>@context.Name</span>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Category">@(context.Category ?? "-")</MudTd>
                            <MudTd DataLabel="Time" Style="text-align: right">@UsageSummary.Format(context.Time)</MudTd>
                            <MudTd DataLabel="Share">
                                <MudProgressLinear Color="Color.Primary" Value="@(context.Share * 100)"/>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager HideRowsPerPage="true"/>
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            @if (m_Summary.Websites.Count > 0)
            {
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6">Websites</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            @UsageSummary.Format(m_Summary.WebsiteTime) in browsers on devices that record websites.
                            <MudLink Href="/settings#websites" Typo="Typo.body2">Excluded websites and history</MudLink>
                        </MudText>
                        <MudTable Items="m_Summary.Websites" Dense="true" Hover="true" Elevation="0" RowsPerPage="10">
                            <HeaderContent>
                                <MudTh>Website</MudTh>
                                <MudTh Style="text-align: right">Time</MudTh>
                                <MudTh Style="width: 30%">Share</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Website">@context.Name</MudTd>
                                <MudTd DataLabel="Time" Style="text-align: right">@UsageSummary.Format(context.Time)</MudTd>
                                <MudTd DataLabel="Share">
                                    <MudProgressLinear Color="Color.Secondary" Value="@(context.Share * 100)"/>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager HideRowsPerPage="true"/>
                            </PagerContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">Devices</MudText>
                    @foreach (var device in m_Summary.Devices)
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.body2">@device.Name: @UsageSummary.Format(device.Time) (@device.Share.ToString("P0"))</MudText>
                            <MudProgressLinear Color="Color.Tertiary" Value="@(device.Share * 100)"/>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private DashboardRange m_Range = DashboardRange.Day;
    private DateTime? m_Anchor;
    private DateTime m_Today = DateTime.Today;
    private int? m_DeviceId;
    private TimeZoneInfo m_Zone = TimeZoneInfo.Local;

    private List<DeviceDto> m_Devices = [];
    private UsageSummary? m_Summary;
    private List<ChartSeries> m_ChartSeries = [];
    private ChartOptions m_ChartOptions = new();
    private Dictionary<int, string> m_Icons = new();
    private string? m_Error;

    /// <summary>Days of the period up to today, for the daily average of a period that is still running.</summary>
    private int ElapsedDays => m_Summary is null
        ? 1
        : Math.Clamp((int)(m_Today - m_Summary.LocalStart).TotalDays + 1, 1, m_Summary.PeriodLabels.Length);

    private string PeriodText => m_Summary is null
        ? ""
        : m_Summary.Range switch
        {
            DashboardRange.Day => m_Summary.LocalStart == m_Today ? "today" : m_Summary.LocalStart.ToString("dddd, dd.MM.yyyy"),
            DashboardRange.Week => $"the week of {m_Summary.LocalStart:dd.MM.}",
            _ => m_Summary.LocalStart.ToString("MMMM yyyy")
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The time zone comes from the browser, which needs JS interop, so loading starts after the first render.
        m_Zone = await ClientTimeZone.GetAsync();
        m_Today = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, m_Zone).Date;
        m_Anchor = m_Today;

        try
        {
            m_Devices = await DeviceManager.GetDevices();
        }
        catch (Exception e)
        {
            m_Error = $"Could not load devices: {e.Message}";
        }

        await LoadAsync();
        await LoadIconsAsync();
    }

    private async Task OnRangeChanged(DashboardRange range)
    {
        m_Range = range;
        await LoadAsync();
    }

    private async Task OnDateChanged(DateTime? date)
    {
        m_Anchor = date ?? m_Today;
        await LoadAsync();
    }

    private async Task OnDeviceChanged(int? deviceId)
    {
        m_DeviceId = deviceId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (localStart, localEnd) = UsageSummary.Period(m_Anchor ?? m_Today, m_Range);
        var (utcStart, utcEnd) = UsageSummary.ToUtc(localStart, localEnd, m_Zone);

        try
        {
            // One hour of margin on both ends for zones with a non-whole-hour offset.
            var usage = await UsageService.GetUsageDataAsync(utcStart.AddHours(-1), utcEnd.AddHours(1), m_DeviceId);
            m_Summary = UsageSummary.Create(usage, localStart, localEnd, m_Range, m_Zone);
            // Hours of a single day are short, so the day view counts minutes. MudBlazor's tick step is an integer.
            var scale = m_Range == DashboardRange.Day ? 60 : 1;
            m_ChartSeries = m_Summary.Series
                .Select(s => new ChartSeries { Name = s.Name, Data = s.Hours.Select(h => Math.Round(h * scale, 1)).ToArray() })
                .ToList();
            var highest = m_ChartSeries.Count == 0
                ? 0
                : Enumerable.Range(0, m_Summary.PeriodLabels.Length).Max(i => m_ChartSeries.Sum(c => c.Data[i]));
            m_ChartOptions = new ChartOptions { YAxisTicks = NiceStep(highest), YAxisLines = true };
            m_Error = null;
        }
        catch (Exception e)
        {
            m_Error = $"Could not load usage: {e.Message}";
            m_Summary = UsageSummary.Create([], localStart, localEnd, m_Range, m_Zone);
        }

        StateHasChanged();
    }

    /// <summary>Tick step giving about four to eight grid lines.</summary>
    private static int NiceStep(double highest)
    {
        foreach (var step in new[] { 1, 2, 5, 10, 15, 20, 30, 60, 120 })
            if (highest / step <= 8)
                return step;
        return 240;
    }

    private async Task LoadIconsAsync()
    {
        try
        {
            var apps = await AppManager.GetAppsAsync();
            m_Icons = apps
                .Where(a => a.IconBitmap.Length > 0)
                .ToDictionary(a => a.Id, a => $"data:image/png;base64,{Convert.ToBase64String(a.IconBitmap)}");
            StateHasChanged();
        }
        catch (Exception)
        {
            // Icons are decoration; the dashboard works without them.
        }
    }
}
