@inherits LayoutComponentBase

@inject IStorage Storage
@inject ISnackbar Snackbar

<CascadingValue Value="this">
    @* The theme class lets app.css adjust colours MudBlazor's palette can't express per theme. *@
    <div class="@(m_IsDarkMode ? "onyx-dark" : "onyx-light")" style="display: contents">
        <CustomErrorBoundary>
            @Body
        </CustomErrorBoundary>
    </div>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<MudThemeProvider Theme="m_MyCustomTheme" IsDarkMode="m_IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code
{
    private bool m_IsDarkMode = true;

    public bool IsDarkMode
    {
        get => m_IsDarkMode;
        set
        {
            m_IsDarkMode = value;
            StateHasChanged();
            Storage.SetItemAsync("darkMode", value);
        }
    }
    
    protected override async Task OnInitializedAsync()
    {
        Snackbar.Configuration.ClearAfterNavigation = true;
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.VisibleStateDuration = 5000;
        Snackbar.Configuration.HideTransitionDuration = 500;
        Snackbar.Configuration.ShowTransitionDuration = 500;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;

        if (await Storage.ContainKeyAsync("darkMode"))
            m_IsDarkMode = await Storage.GetItemAsync<bool>("darkMode");
    }

    /// <summary>
    /// The Onyx palette, after the gem: black onyx with grey and pearl bands, and sardonyx's red-brown as the
    /// accent. Dark is the default; the light theme is the pearl band with onyx ink.
    /// </summary>
    private readonly MudTheme m_MyCustomTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#B4532A",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#6F8594",
            Tertiary = "#3B4048",
            Info = "#6F8594",
            Success = "#5E7F5A",
            Warning = "#C08A2E",
            Error = "#B3261E",
            Black = "#0B0C0E",
            Background = "#F7F5F1",
            BackgroundGray = "#EEEBE5",
            Surface = "#FFFFFF",
            DrawerBackground = "#EEEBE5",
            DrawerText = "#131518",
            AppbarBackground = "#131518",
            AppbarText = "#F7F5F1",
            TextPrimary = "#131518",
            TextSecondary = "#5B616B",
            ActionDefault = "#3B4048",
            ActionDisabled = "#A7ACB4",
            ActionDisabledBackground = "#E2DED6",
            LinesDefault = "#DAD6CE",
            LinesInputs = "#A7ACB4",
            TableLines = "#E2DED6",
            Divider = "#DAD6CE",
        },
