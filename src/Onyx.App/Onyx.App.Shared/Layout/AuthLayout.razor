@inherits LayoutComponentBase
@layout AppLayout
@inject NavigationManager NavigationManager

<div class="account-layout">
    <nav class="account-nav" aria-label="Account">
        @foreach (var (name, url) in s_Items)
        {
            <a href="@url" class="account-nav-item @(IsSelected(url) ? "selected" : "")">@name</a>
        }
    </nav>
    <div class="account-content">
        @Body
    </div>
</div>

@code {
    private static readonly (string Name, string Url)[] s_Items =
    [
        ("Profile", "/account/manage/profile"),
        ("Password", "/account/manage/changepassword"),
        ("External logins", "/account/manage/external"),
        ("Two-factor", "/account/manage/2fa"),
        ("Personal data", "/account/manage/personal-data"),
    ];

    private bool IsSelected(string url) =>
        ("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri)).StartsWith(url, StringComparison.OrdinalIgnoreCase);
}
