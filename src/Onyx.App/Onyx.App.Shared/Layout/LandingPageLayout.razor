@inherits LayoutComponentBase
@layout MainLayout
@inject IPlatformService PlatformService
@inject NavigationManager NavigationManager

@* Public pages (landing page, privacy policy, downloads). The header is sticky inside the page's own scroll
   container, so content always starts below it and can never be covered by it. *@

<div class="public-shell">
    @if (PlatformService.IsMaui())
    {
        <header class="public-header compact">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@(() => NavigationManager.NavigateTo(m_Back))" aria-label="Back"/>
            <img src="_content/Onyx.App.Shared/img/Icon.png" alt="" class="public-logo" width="32" height="32"/>
            <span class="public-brand">Onyx</span>
        </header>
    }
    else
    {
        <header class="public-header">
            <a href="/" class="public-home" aria-label="Onyx home">
                <img src="_content/Onyx.App.Shared/img/Icon.png" alt="" class="public-logo" width="32" height="32"/>
                <span class="public-brand">Onyx</span>
            </a>
            <nav class="public-links">
                <a href="/#features">Features</a>
                <a href="/#privacy">Privacy</a>
                <a href="/downloads">Download</a>
            </nav>
            <MudSpacer/>
            <MudButton Href="/account/login" Variant="Variant.Text" Color="Color.Inherit" Class="public-signin">Sign in</MudButton>
            <MudButton Href="/account/register" Variant="Variant.Filled" Color="Color.Primary">Get started</MudButton>
        </header>
    }
    <main class="public-main">
        @Body
    </main>
    @if (!PlatformService.IsMaui())
    {
        <footer class="public-footer">
            <span>Onyx @AppVersion.Current.Number · open source (AGPL-3.0) · end-to-end encrypted</span>
            <span class="public-footer-links">
                <a href="/privacy">Privacy policy</a>
                <a href="/downloads">Downloads</a>
                <a href="/about">About</a>
                <a href="https://the-onyx-team.github.io/Onyx/" target="_blank" rel="noopener">Documentation</a>
            </span>
        </footer>
    }
</div>

@code {
    // In the apps, public pages are opened from inside the app or from the sign-in page.
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? Auth { get; set; }

    private string m_Back = "/home";

    protected override async Task OnInitializedAsync()
    {
        if (Auth is not null && (await Auth).User.Identity?.IsAuthenticated != true)
            m_Back = "/account/login";
    }
}
