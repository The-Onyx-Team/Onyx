@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager NavigationManager
@inject IUserManager UserManager
@implements IDisposable

@* The signed-in app: navigation rail (bottom bar on phones), app bar, and the page behind the vault gate, which
   asks for the passphrase until this device can decrypt the user's data. *@

<div id="app-container">
    <nav id="nav" aria-label="Main">
        <a href="/home" class="nav-brand" aria-label="Onyx home">
            <img src="_content/Onyx.App.Shared/img/Icon.png" alt="" width="34" height="34"/>
        </a>
        @foreach (var item in s_NavItems)
        {
            <a href="@item.Url" class="nav-item @(IsSelected(item) ? "selected-nav-item" : "")" title="@item.Name" aria-label="@item.Name"
               aria-current="@(IsSelected(item) ? "page" : null)">
                <MudIcon Icon="@item.Icon"/>
            </a>
        }
    </nav>
    <div id="app-box">
        <MudAppBar Class="app-bar" Elevation="0" Dense="true">
            <MudText Typo="Typo.h6" Class="app-bar-title">@Title</MudText>
            <MudSpacer/>
            <MudTooltip Text="@(MainLayout.IsDarkMode ? "Light theme" : "Dark theme")">
                <MudIconButton Icon="@(MainLayout.IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Color="Color.Inherit" OnClick="@(() => MainLayout.IsDarkMode = !MainLayout.IsDarkMode)"
                               aria-label="Switch theme"/>
            </MudTooltip>
            <MudTooltip Text="@($"About Onyx {AppVersion.Current.Number}")">
                <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Inherit" Href="/about" aria-label="About"/>
            </MudTooltip>
            <MudTooltip Text="Account">
                <MudIconButton Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit"
                               Href="/account/manage/profile" aria-label="Account"/>
            </MudTooltip>
            <MudTooltip Text="Sign out">
                <MudIconButton Icon="@Icons.Material.Outlined.Logout" Color="Color.Inherit" OnClick="Logout"
                               aria-label="Sign out"/>
            </MudTooltip>
        </MudAppBar>
        <MudMainContent Class="app-main">
            <VaultGate>
                @Body
            </VaultGate>
        </MudMainContent>
    </div>
</div>

@code
{
    [CascadingParameter] public required MainLayout MainLayout { get; set; }

    private sealed record NavItem(string Name, string Url, string Icon);

    private static readonly NavItem[] s_NavItems =
    [
        new("Home", "/home", Icons.Material.Outlined.SpaceDashboard),
        new("Goals", "/goals", Icons.Material.Outlined.Flag),
        new("Focus", "/focus", Icons.Material.Outlined.CenterFocusStrong),
        new("Friends", "/friends", Icons.Material.Outlined.Group),
        new("Reports", "/reports", Icons.Material.Outlined.Assessment),
        new("Devices", "/devices", Icons.Material.Outlined.Devices),
        new("Settings", "/settings", Icons.Material.Outlined.Settings),
    ];

    private string Path => "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];

    private bool IsSelected(NavItem item) => Path.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase);

    private string Title => s_NavItems.FirstOrDefault(IsSelected)?.Name
                            ?? (Path.StartsWith("/account", StringComparison.OrdinalIgnoreCase) ? "Account" : "Onyx");

    protected override void OnInitialized() => NavigationManager.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await UserManager.LogoutAsync();
        NavigationManager.NavigateTo("/account/login");
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
