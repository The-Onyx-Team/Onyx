@inherits LayoutComponentBase

@layout MainLayout

<MudContainer Gutters="false" Style="height: 100%" Class="ma-0 pa-0">
    <MudContainer Style="height: 100%; 
                         position: absolute; 
                         z-index: -1000 !important; 
                         background-image: url('_content/Onyx.App.Shared/img/LoginBackground.png'); 
                         background-position: center; 
                         background-repeat: no-repeat; 
                         background-size: cover;"
                  Class="ma-0 pa-0 mud-width-full" MaxWidth="MaxWidth.False">
    </MudContainer>
    <MudContainer Style="height: 15vh; position: absolute;" Class="pa-0 ma-5 d-flex align-center">
        <img src="_content/Onyx.App.Shared/img/Icon.png" alt="Onyx" width="64" height="64" class="mr-5 ml-5"
             style="max-width: 80px; min-width: 48px; width: 10%; height: auto;"/>
        <MudText Typo="Typo.h4" Style="color: #FFFFFF">Onyx</MudText>
    </MudContainer>
    <MudContainer Class="auth-card d-flex flex-column align-center justify-center" MaxWidth="MaxWidth.Medium">
        <MudGrid Justify="Justify.Center" Style="background-color: transparent;">
            <MudItem lg="9" md="9" sm="10" xs="12" Class="d-flex flex-column align-content-space-between justify-center">
                @Body
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudContainer>
