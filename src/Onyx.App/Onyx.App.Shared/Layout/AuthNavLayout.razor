@inherits LayoutComponentBase

@layout MainLayout

@* Sign-in pages: the brand at the top and a pearl card centred on the onyx photo, on every screen size. The page
   scrolls when the card is taller than the window. *@
<div class="auth-page">
    <header class="auth-brand">
        <img src="_content/Onyx.App.Shared/img/Icon.png" alt="" width="48" height="48"/>
        <span>Onyx</span>
    </header>
    <main class="auth-main">
        <div class="auth-card">
            @Body
        </div>
    </main>
</div>
