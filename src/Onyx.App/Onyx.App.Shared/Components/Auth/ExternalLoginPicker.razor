@using Onyx.Data.ApiSchema
@inject IUserManager UserManager

@* Sign-in with Google, Microsoft or GitHub (web only): a form post to the server, which redirects to the provider. *@
@if (m_Schemes.Count > 0)
{
    <MudText Align="Align.Center" Class="mt-2 mb-1">Or sign in with</MudText>
    <form action="/account/perform-external-login" method="post" class="d-flex justify-center gap-2">
        <input type="hidden" name="returnUrl" value="@ReturnUrl"/>
        @foreach (var scheme in m_Schemes)
        {
            <button type="submit" name="provider" value="@scheme.Name" class="external-login-button"
                    title="@($"Sign in with {scheme.DisplayName}")">
                <i class="@Icon(scheme.Name)"></i> @scheme.DisplayName
            </button>
        }
    </form>
}

@code {
    [Parameter] public string? ReturnUrl { get; set; }

    private IReadOnlyList<ExternalSchemeDto> m_Schemes = [];

    protected override async Task OnInitializedAsync() => m_Schemes = await UserManager.GetExternalSchemesAsync();

    private static string Icon(string name) => name.ToLowerInvariant() switch
    {
        "github" => "fa-brands fa-github",
        "google" or "googleopenidconnect" => "fa-brands fa-google",
        "microsoft" => "fa-brands fa-microsoft",
        _ => "fa-solid fa-right-to-bracket"
    };
}
