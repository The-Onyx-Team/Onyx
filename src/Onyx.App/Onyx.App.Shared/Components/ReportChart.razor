@using Onyx.Data.ApiSchema
@* One chart of a weekly report. The SVG is drawn on this device by ReportCharts, which escapes all text. *@

@if (Report.Charts.TryGetValue(Key, out var svg))
{
    <div class="report-section mb-4">
        @if (Title is not null)
        {
            <MudText Typo="Typo.h6" Style="font-weight: 700">@Title</MudText>
        }
        @if (Caption is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-2 report-muted">@Caption</MudText>
        }
        <div class="report-chart" role="img" aria-label="@(Title ?? "Chart")">@((MarkupString)svg)</div>
    </div>
}

@code {
    [Parameter, EditorRequired] public WeeklyReportDto Report { get; set; } = null!;
    [Parameter, EditorRequired] public string Key { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Caption { get; set; }
}
