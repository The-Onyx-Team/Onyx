@* Asks for one line of text. *@
<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="@Label" @bind-Value="Value" Variant="Variant.Outlined" Immediate="true"
                      AutoFocus="true" OnKeyDown="@(e => { if (e.Key == "Enter") Confirm(); })"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="string.IsNullOrWhiteSpace(Value)">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "OK";

    private void Confirm() => MudDialog.Close(DialogResult.Ok(Value));
}
