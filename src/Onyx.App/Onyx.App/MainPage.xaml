<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Onyx.App"
             xmlns:shared="clr-namespace:Onyx.App.Shared;assembly=Onyx.App.Shared"
             xmlns:components="clr-namespace:Onyx.App.Components"
             x:Class="Onyx.App.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             SafeAreaEdges="All">
    <!-- Android 15+ draws apps edge to edge. "All" keeps the web view clear of the status bar, the navigation
         bar and the keyboard, so the app bars and the bottom navigation are not covered. -->

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
