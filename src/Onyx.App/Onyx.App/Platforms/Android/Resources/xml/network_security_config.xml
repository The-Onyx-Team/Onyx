<?xml version="1.0" encoding="utf-8"?>
<!-- Only used by builds with -p:OnyxPrivateNetwork=true (see MainApplication.cs): servers reachable only through
     a VPN or LAN, over plain HTTP or with a certificate from a CA the user installed on the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
