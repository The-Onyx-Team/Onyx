<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <title>Onyx</title>
    <link rel="icon" type="image/png" href="_content/Onyx.App.Shared/img/Icon.png" />
    @* Installable as an app (PWA): "Add to Home Screen" on iPhone and iPad, "Install" in Chromium browsers. *@
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0C0E" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Onyx" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="_content/Onyx.App.Shared/app.css?v=@Onyx.App.Shared.Services.AppVersion.CacheToken" />
    <HeadOutlet @rendermode="s_RenderMode" />
</head>

<body>
    <Routes @rendermode="s_RenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    // The whole UI runs in the browser (WebAssembly) and is not prerendered: it needs the user's key, which only
    // the browser has, to show anything.
    private static readonly IComponentRenderMode s_RenderMode = new InteractiveWebAssemblyRenderMode(prerender: false);
}
