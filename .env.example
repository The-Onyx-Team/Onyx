# Copy to .env (which is gitignored) and fill in. Used by docker-compose.yaml.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# Address and host port the app is published on (default 127.0.0.1:8080, for a reverse proxy on this host).
# ONYX_BIND=10.8.0.1
# ONYX_PORT=8080

# Allow new accounts. Set to false once your own accounts exist; existing users can still sign in.
Onyx__AllowRegistration=true

# Shown in the privacy policy: who runs this server (name, postal address) and the contact for data requests.
Onyx__Operator=
Onyx__ContactEmail=
# Shown in the privacy policy: where the server runs, and the service that delivers emails (if any).
Onyx__HostingLocation=
Onyx__EmailProvider=

# Outgoing mail for account confirmation and password reset: smtp://host:port (no TLS) or
# smtps://user:password@host:587 (STARTTLS, URL-encode the password). Without it no emails are sent.
ConnectionStrings__mail=
# Sender address; must be one your SMTP server is allowed to send as.
Mail__From=

# Optional external logins. A provider is only enabled when both values are set.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=
