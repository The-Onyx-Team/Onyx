# Copy to .env (which is gitignored) and fill in. Used by docker-compose.yaml.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# Outgoing mail for account confirmation and password reset, as smtp://host:port.
# Without it the app starts, but no emails are sent.
ConnectionStrings__mail=

# Optional external logins. A provider is only enabled when both values are set.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=
